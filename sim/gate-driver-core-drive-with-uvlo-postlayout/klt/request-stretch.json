{
  "netlist": "body.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "typical",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "ff",
        "sections": [
          "ff",
          "res_ff",
          "bjt_ff",
          "diode_ff",
          "moscap_ff",
          "mimcap_ff"
        ]
      },
      {
        "name": "ss",
        "sections": [
          "ss",
          "res_ss",
          "bjt_ss",
          "diode_ss",
          "moscap_ss",
          "mimcap_ss"
        ]
      },
      {
        "name": "fs",
        "sections": [
          "fs",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "sf",
        "sections": [
          "sf",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      }
    ],
    "temperature_c": [
      -40.0,
      27.0,
      125.0
    ],
    "supply_v": {
      "vsup_logic": [
        3.3
      ],
      "vsup_drv": [
        6.0
      ]
    }
  },
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 1800
  },
  "analysis": {
    "kind": "tran",
    "args": "0.1n 700n"
  },
  "measurements": [
    {
      "name": "trise_s",
      "unit": "s",
      "spec_row": "rise_fall_time",
      "spice": ".meas tran trise_s TRIG v(vout_n) VAL=0.1 RISE=1 TARG v(vout_n) VAL=0.9 RISE=1",
      "limits": {
        "max": 5e-08
      }
    },
    {
      "name": "tfall_s",
      "unit": "s",
      "spec_row": "rise_fall_time",
      "spice": ".meas tran tfall_s TRIG v(vout_n) VAL=0.9 FALL=1 TARG v(vout_n) VAL=0.1 FALL=1",
      "limits": {
        "max": 5e-08
      }
    },
    {
      "name": "tpdlh_s",
      "unit": "s",
      "spec_row": "propagation_delay",
      "spice": ".meas tran tpdlh_s TRIG v(vin_n) VAL=0.5 RISE=1 TARG v(vout_n) VAL=0.5 RISE=1",
      "limits": {
        "max": 2.5e-08
      }
    },
    {
      "name": "tpdhl_s",
      "unit": "s",
      "spec_row": "propagation_delay",
      "spice": ".meas tran tpdhl_s TRIG v(vin_n) VAL=0.5 FALL=1 TARG v(vout_n) VAL=0.5 FALL=1",
      "limits": {
        "max": 2.5e-08
      }
    },
    {
      "name": "ipeak_source_a",
      "unit": "A",
      "spec_row": "peak_source_current",
      "expr": "vecmax(i(vimeas))",
      "limits": {
        "min": 1.0
      }
    },
    {
      "name": "ipeak_sink_a",
      "unit": "A",
      "spec_row": "peak_sink_current",
      "expr": "-vecmin(i(vimeas))",
      "limits": {
        "min": 1.0
      }
    },
    {
      "name": "vout_max_v",
      "unit": "V",
      "expr": "vecmax(v(OUT))",
      "limits": {
        "max": 6.6
      }
    },
    {
      "name": "vout_min_v",
      "unit": "V",
      "expr": "vecmin(v(OUT))",
      "limits": {
        "min": -0.05
      }
    },
    {
      "name": "vin_max_v",
      "unit": "V",
      "expr": "vecmax(v(IN))"
    },
    {
      "name": "vin_min_v",
      "unit": "V",
      "expr": "vecmin(v(IN))"
    },
    {
      "name": "indrv_max_v",
      "unit": "V",
      "expr": "vecmax(v(IN_DRV))",
      "limits": {
        "max": 6.6
      }
    },
    {
      "name": "indrv_min_v",
      "unit": "V",
      "expr": "vecmin(v(IN_DRV))",
      "limits": {
        "min": -0.05
      }
    },
    {
      "name": "n1_max_v",
      "unit": "V",
      "expr": "vecmax(v(x2_n1))",
      "limits": {
        "max": 6.6
      }
    },
    {
      "name": "n1_min_v",
      "unit": "V",
      "expr": "vecmin(v(x2_n1))",
      "limits": {
        "min": -0.05
      }
    },
    {
      "name": "n2_max_v",
      "unit": "V",
      "expr": "vecmax(v(x2_n2))",
      "limits": {
        "max": 6.6
      }
    },
    {
      "name": "n2_min_v",
      "unit": "V",
      "expr": "vecmin(v(x2_n2))",
      "limits": {
        "min": -0.05
      }
    },
    {
      "name": "n3_max_v",
      "unit": "V",
      "expr": "vecmax(v(x2_n3))",
      "limits": {
        "max": 6.6
      }
    },
    {
      "name": "n3_min_v",
      "unit": "V",
      "expr": "vecmin(v(x2_n3))",
      "limits": {
        "min": -0.05
      }
    },
    {
      "name": "n4_max_v",
      "unit": "V",
      "expr": "vecmax(v(x2_n4))",
      "limits": {
        "max": 6.6
      }
    },
    {
      "name": "n4_min_v",
      "unit": "V",
      "expr": "vecmin(v(x2_n4))",
      "limits": {
        "min": -0.05
      }
    },
    {
      "name": "n5_max_v",
      "unit": "V",
      "expr": "vecmax(v(x2_n5))",
      "limits": {
        "max": 6.6
      }
    },
    {
      "name": "n5_min_v",
      "unit": "V",
      "expr": "vecmin(v(x2_n5))",
      "limits": {
        "min": -0.05
      }
    },
    {
      "name": "uvlo_lockout_at_in_high",
      "unit": "V",
      "spice": ".meas tran uvlo_lockout_at_in_high FIND v(x3_lockout) AT=200n",
      "limits": {
        "min": -0.5,
        "max": 6.6
      }
    },
    {
      "name": "uvlo_vout_at_in_high_v",
      "unit": "V",
      "spice": ".meas tran uvlo_vout_at_in_high_v FIND v(OUT) AT=200n",
      "limits": {
        "min": -0.05,
        "max": 6.6
      }
    },
    {
      "name": "uvlo_vdrv_at_in_high_v",
      "unit": "V",
      "spice": ".meas tran uvlo_vdrv_at_in_high_v FIND v(VDD_DRV) AT=200n",
      "limits": {
        "min": -0.05,
        "max": 6.6
      }
    }
  ],
  "options": {
    "timeout_s": 3000,
    "keep_artifacts": false,
    "ngspice_init": [
      "set measureprec=10",
      "set numdgt=10"
    ]
  }
}
