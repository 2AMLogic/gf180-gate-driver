{
  "netlist": "body-startup-deadinit-2v0-nokick.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "typical",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      }
    ],
    "temperature_c": [
      27.0
    ]
  },
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 1800
  },
  "analysis": {
    "kind": "tran",
    "args": "10n 200u"
  },
  "measurements": [
    {
      "name": "nvref_settled",
      "unit": "V",
      "spec_row": "uvlo",
      "spice": ".meas tran nvref_settled AVG v(nvref) FROM=150u TO=200u",
      "limits": {
        "min": 1.1
      }
    },
    {
      "name": "t_alive",
      "unit": "s",
      "spice": ".meas tran t_alive WHEN v(nvref)=1.1 RISE=1",
      "on_unreached": "null"
    },
    {
      "name": "lockout_min",
      "unit": "V",
      "spec_row": "uvlo",
      "spice": ".meas tran lockout_min MIN v(lockout) FROM=150u TO=200u",
      "limits": {
        "min": 1.5
      }
    },
    {
      "name": "out_max",
      "unit": "V",
      "spec_row": "uvlo",
      "spice": ".meas tran out_max MAX v(OUT) FROM=150u TO=200u",
      "limits": {
        "max": 0.5
      }
    }
  ],
  "options": {
    "timeout_s": 3000,
    "keep_artifacts": false,
    "ngspice_init": [
      "set measureprec=10",
      "set numdgt=10"
    ],
    "initial_conditions": [
      {
        "match": {},
        "values": {
          "nfb": 2.0
        }
      }
    ]
  }
}
