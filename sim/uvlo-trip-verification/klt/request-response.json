{
  "netlist": "body-response.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "typical",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "ff",
        "sections": [
          "ff",
          "res_ff",
          "bjt_ff",
          "diode_ff",
          "moscap_ff",
          "mimcap_ff"
        ]
      },
      {
        "name": "ss",
        "sections": [
          "ss",
          "res_ss",
          "bjt_ss",
          "diode_ss",
          "moscap_ss",
          "mimcap_ss"
        ]
      },
      {
        "name": "fs",
        "sections": [
          "fs",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "sf",
        "sections": [
          "sf",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      }
    ],
    "temperature_c": [
      -40.0,
      27.0,
      125.0
    ]
  },
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 1800
  },
  "analysis": {
    "kind": "tran",
    "args": "0.05n 2000n"
  },
  "measurements": [
    {
      "name": "response_s",
      "unit": "s",
      "spec_row": "uvlo",
      "spice": ".meas tran response_s TRIG v(VDD_DRV) VAL=3.6 FALL=1 TARG v(OUT) VAL=0.5 FALL=1",
      "limits": {
        "max": 5e-07
      }
    }
  ],
  "options": {
    "timeout_s": 3000,
    "keep_artifacts": false,
    "ngspice_init": [
      "set measureprec=10",
      "set numdgt=10"
    ]
  }
}
