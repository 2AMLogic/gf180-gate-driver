{
  "netlist": "body-rail.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "typical",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "ff",
        "sections": [
          "ff",
          "res_ff",
          "bjt_ff",
          "diode_ff",
          "moscap_ff",
          "mimcap_ff"
        ]
      },
      {
        "name": "ss",
        "sections": [
          "ss",
          "res_ss",
          "bjt_ss",
          "diode_ss",
          "moscap_ss",
          "mimcap_ss"
        ]
      },
      {
        "name": "fs",
        "sections": [
          "fs",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "sf",
        "sections": [
          "sf",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      }
    ],
    "temperature_c": [
      -40.0,
      27.0,
      125.0
    ],
    "supply_v": {
      "vsup_drv": [
        6.0
      ]
    }
  },
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 1800
  },
  "analysis": {
    "kind": "op",
    "args": ""
  },
  "measurements": [
    {
      "name": "drive_rail_v",
      "unit": "V",
      "spec_row": "drive_rail",
      "expr": "v(VDD_DRV)",
      "limits": {
        "min": 6.0,
        "max": 6.0
      }
    }
  ],
  "options": {
    "timeout_s": 3000,
    "keep_artifacts": false,
    "ngspice_init": [
      "set measureprec=10",
      "set numdgt=10"
    ]
  }
}
