* --- OUT pulldown: forces OUT low during lockout, overriding IN
* unconditionally (XMPD's gate is driven only from this cell's own
* comparator chain -- IN/IN_DRV never reach this device). Sized (W=10u,
* m=800, effective 8000u) to dominate output_stage's final push-pull
* stage (design/output_stage.sch's MP6, W=10u m=500) so OUT is actively
* held low even while output_stage's own final stage is trying to drive
* it high. ---
C {symbols/nfet_06v0.sym} 2100 0 0 0 {name=MPD
L=0.7u
W=10u
nf=1
m=800
ad="'int((nf+1)/2) * W/nf * 0.18u'"
pd="'2*int((nf+1)/2) * (W/nf + 0.18u)'"
as="'int((nf+2)/2) * W/nf * 0.18u'"
ps="'2*int((nf+2)/2) * (W/nf + 0.18u)'"
nrd="'0.18u / W'" nrs="'0.18u / W'"
sa=0 sb=0 sd=0
model=nfet_06v0
spiceprefix=X
}
C {devices/lab_pin.sym} 2120 -30 0 0 {name=l49 lab=OUT}
C {devices/lab_pin.sym} 2080 0 0 0 {name=l50 lab=lockout}
C {devices/lab_pin.sym} 2120 30 0 0 {name=l51 lab=GND_DRV}
C {devices/lab_pin.sym} 2120 0 0 0 {name=l52 lab=GND_DRV}

